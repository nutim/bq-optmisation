FINOPS_CONTROL_PROJECT_ID=your-finops-control-project
FINOPS_CONTROL_DATASET=finops_control
FINOPS_CONTROL_LOCATION=EU
FINOPS_COLLECTION_TOPIC=bigquery-finops-collection
FINOPS_MODEL=gemini-3.7-flash
FINOPS_VERTEX_LOCATION=global
FINOPS_LOOKBACK_DAYS=30
FINOPS_EXPENSIVE_QUERY_BYTES=1000000000000
FINOPS_LARGE_TABLE_BYTES=1000000000000
FINOPS_UNUSED_TABLE_DAYS=90
FINOPS_ON_DEMAND_USD_PER_TIB=6.25
FINOPS_ACTIVE_STORAGE_USD_PER_GIB_MONTH=0.02
FINOPS_SAVINGS_RATIO_EXPENSIVE_QUERY=0.25
FINOPS_SAVINGS_RATIO_SELECT_STAR=0.15
FINOPS_SAVINGS_RATIO_LARGE_TABLE=0.2
FINOPS_SAVINGS_RATIO_PARTITION_SCAN=0.5
FINOPS_SAVINGS_RATIO_CACHE_MISS=0.3
FINOPS_SAVINGS_RATIO_TIME_TRAVEL=0.5
FINOPS_MIN_CACHE_EXECUTIONS=10
FINOPS_CACHE_MISS_QUERY_BYTES=100000000000
FINOPS_PARTITION_SCAN_RATIO=0.9
FINOPS_TIME_TRAVEL_OVERHEAD_RATIO=0.25
FINOPS_TIME_TRAVEL_MIN_BYTES=10000000000
FINOPS_COMMITMENT_REVIEW_USD=5000
# Comma-separated projects allowed to host target reader/executor SAs.
# Empty means service accounts must live in the registered target project.
FINOPS_ALLOWED_SA_PROJECTS=
# Verify Pub/Sub push OIDC tokens in the application (defense in depth on top
# of Cloud Run IAM). Disable only for local development.
FINOPS_VERIFY_PUBSUB_TOKENS=true
FINOPS_PUBSUB_INVOKER_SERVICE_ACCOUNT=bq-finops-invoker@your-finops-control-project.iam.gserviceaccount.com
FINOPS_SERVICE_URL=https://YOUR-SERVICE-URL
FINOPS_SERVE_ADK_WEB_UI=false
FINOPS_TRACE_TO_CLOUD=true
FINOPS_ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/mcp
FINOPS_ATLASSIAN_MCP_AUTH_SECRET=projects/your-finops-control-project/secrets/atlassian-mcp/versions/latest
FINOPS_GITLAB_MCP_URL=https://gitlab.example.com/api/v4/mcp
FINOPS_GITLAB_MCP_AUTH_SECRET=projects/your-finops-control-project/secrets/gitlab-mcp/versions/latest
FINOPS_MCP_TIMEOUT_SECONDS=60
GOOGLE_CLOUD_PROJECT=your-finops-control-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
